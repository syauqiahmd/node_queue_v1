// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  fullName  String?   @map("full_name")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String    @map("created_by")
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by")

  services  Service[]
  users     UserOrganization[]
}


model Service {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  prefix          String       @unique @db.VarChar(3)
  isActive        Boolean      @default(true) @map("is_active")
  organizationId  String       @db.Uuid @map("organization_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  createdBy       String       @map("created_by")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedBy       String?      @map("updated_by")

  organization    Organization @relation(fields: [organizationId], references: [id])
  counters        Counter[]
  tickets         Ticket[]     @relation("ServiceTicket")
}

model Counter {
  id              String       @id @default(uuid()) @db.Uuid
  counterNumber   String       @unique @db.VarChar(3)
  isActive        Boolean      @default(true) @map("is_active")
  serviceId       String       @db.Uuid @map("service_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  createdBy       String       @map("created_by")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  updatedBy       String?      @map("updated_by")

  service         Service      @relation(fields: [serviceId], references: [id])
  assignedTickets Ticket[]     @relation("CounterTicket")
}

enum Role {
  ADMIN
  USER
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  userName              String    @unique
  fullName              String
  role                  Role
  password              String
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  createdBy             String    @map("created_by")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  updatedBy             String?   @map("updated_by")

  assigneeOrganization  UserOrganization[]
}

model UserOrganization {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid @map("user_id")
  organizationId  String          @db.Uuid @map("organization_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  createdBy       String          @map("created_by")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  updatedBy       String?         @map("updated_by")

  user            User            @relation(fields: [userId], references: [id])
  organization    Organization    @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId])
}

model Ticket {
  id                        String   @id @default(uuid()) @db.Uuid
  queueNumber               Int      
  queueDate                 DateTime @map("queue_date") // date only, for daily reset and unique
  prefix                    String   @db.VarChar(3)
  isCall                    Boolean  @default(false) @map("is_call")
  isResolved                Boolean  @default(false) @map("is_resolved")
  serviceId                 String   @db.Uuid @map("service_id")
  latestAssigneeCounterId   String?  @db.Uuid @map("latest_assignee_counter_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  updatedBy                 String?  @map("updated_by")

  service                   Service  @relation("ServiceTicket", fields: [serviceId], references: [id])
  latestAssigneeCounter     Counter? @relation("CounterTicket", fields: [latestAssigneeCounterId], references: [id])

  @@index([serviceId, queueDate])
  @@unique([serviceId, queueNumber, queueDate])
}













