# Application
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
PRODUCTION_HOST=https://your-production-domain.com
WEBSOCKET_PORT=8080

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_queue?schema=public

# Security
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=6h
BCRYPT_SALT_ROUNDS=12

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (in minutes)
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX=100

# Google Cloud
# Path to your service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=node-queue-assets
S3_REGION=us-east-1
S3_SOUND_EXPIRATION_HOURS=8

# Cron Job Schedule (in cron format)
PRE_CALCULATE_TIME='0 21 * * *'
HOUSEKEEPING_TIME='0 22 * * 0'
