# Application
NODE_ENV=development
PORT=8000
TZ=Asia/Makassar
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
PRODUCTION_HOST=https://your-production-domain.com
WEBSOCKET_PORT=8080

# Logging / observability
# LOG_LEVEL defaults to "info" in production and "debug" otherwise.
LOG_LEVEL=debug
# Production only: minimum level echoed to stdout (PM2 logs). Files always get LOG_LEVEL.
LOG_CONSOLE_LEVEL=warn
# Prisma queries slower than this (ms) are logged as warnings in every environment.
PRISMA_SLOW_QUERY_MS=500
# Max time (ms) for graceful shutdown on SIGTERM/SIGINT before forcing exit.
SHUTDOWN_TIMEOUT_MS=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_queue?schema=public

# Security
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=6h
BCRYPT_SALT_ROUNDS=12

# Service-to-service API keys for /private routes: name:key pairs, comma-separated
# Generate a new one with: npm run generate:service-key -- <serviceName>
SERVICE_API_KEYS=exampleService:changeme-generate-a-real-secret

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate Limiting (in minutes)
RATE_LIMIT_WINDOW=1
RATE_LIMIT_MAX=100

# Rate Limiting for the anonymous /public write endpoints specifically (in minutes)
# Tighter than the global default above since these are open, unauthenticated writes.
PUBLIC_RATE_LIMIT_WINDOW=1
PUBLIC_RATE_LIMIT_MAX=10

# Google Cloud
# Path to your service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# S3 Configuration
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=node-queue-assets
S3_REGION=us-east-1
S3_SOUND_EXPIRATION_HOURS=8

# Cron Job Schedule (in cron format)
PRE_CALCULATE_TIME='0 21 * * *'
HOUSEKEEPING_TIME_QUEUE_DATA='0 22 * * 0'
HOUSEKEEPING_TIME_S3_FILES='0 23 * * 0'

# master password for manually run the cron job
MASTER_PASSWORD="rajaSinga"
