{
  "apps": [
    {
      "name": "node-queue-app",
      "script": "src/server.js",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "kill_timeout": 6000,
      "env": {
        "NODE_ENV": "development"
      },
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 3000
      }
    }
  ]
}
